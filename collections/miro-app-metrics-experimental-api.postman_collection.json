          "id": "26bd1550-80f9-49a5-ac18-c197d999703c",
          "name": "Get app metrics",
          "request": {
            "name": "Get app metrics",
            "description": {
              "content": "Returns a list of usage metrics for a specific app for a given time range, grouped by requested time period.\n\nThis endpoint requires an app management API token. It can be generated in the <a href=\"https://developers.miro.com/?features=appMetricsToken#your-apps\">Your Apps</a> section of Developer Hub.<br/>\n<h3>Required scope</h3> <a target=_blank href=https://developers.miro.com/reference/scopes>boards:read</a><br/>\n<h3>Rate limiting</h3> <a target=_blank href=\"/reference/rate-limiting#rate-limit-tiers\">Level 1</a><br/>\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2-experimental",
                "apps",
                ":app_id",
                "metrics"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<date>",
                  "description": "(Required) Start date of the period in UTC format. For example, 2024-12-31."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<date>",
                  "description": "(Required) End date of the period in UTC format. For example, 2024-12-31."
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "WEEK",
                  "description": "Group data by this time period."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "app_id",
                  "description": "(Required) ID of the app to get metrics for."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
